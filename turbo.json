{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["public/brand/**", "scripts/sync-brand-assets.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "public/brand/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  },
  "globalPassThroughEnv": ["PUBLIC_APP_URL", "SOCIAL_APP_URL", "PERSONAL_APP_URL", "RESEARCHER_APP_URL", "ADMIN_APP_URL", "NEXT_PUBLIC_API_URL", "VITE_API_URL", "VITE_SOCIAL_APP_URL"]
}
