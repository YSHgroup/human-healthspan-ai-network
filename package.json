{
  "name": "human-healthspan-ai-network",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check": "pnpm lint && pnpm typecheck",
    "sync:brand-assets": "node scripts/sync-brand-assets.mjs",
    "dev:social": "pnpm --filter @healthspan/social-web dev",
    "dev:personal": "pnpm --filter @healthspan/personal-web dev",
    "dev:researcher": "pnpm --filter @healthspan/researcher-web dev",
    "dev:admin": "pnpm --filter @healthspan/admin dev",
    "dev:api": "cd api && python -m uvicorn app.main:app --reload --port 8000",
    "test:api": "PYTHONPATH=api:ai python -m pytest tests/api -q",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.2"
  }
}
