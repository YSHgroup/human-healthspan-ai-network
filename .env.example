APP_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
SESSION_COOKIE_NAME=healthspan_session
SESSION_TTL_DAYS=30
# Comma-separated allowlist; platform admin accounts must also be email-verified.
PLATFORM_ADMIN_EMAILS=

POSTGRES_DB=healthspan
POSTGRES_USER=healthspan
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite:///./healthspan.db
# Private API-managed uploads; keep this directory outside all static/public asset roots.
RESEARCH_FILE_STORAGE_PATH=.data/research-files
# To use PostgreSQL instead, start it separately and set:
# DATABASE_URL=postgresql+psycopg://healthspan:replace-with-a-local-development-password@localhost:5432/healthspan

REDIS_URL=redis://localhost:6379/0

SOCIAL_APP_URL=http://localhost:3000
PERSONAL_APP_URL=http://localhost:3001
RESEARCHER_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3003
PUBLIC_APP_URL=http://localhost:3000
COOKIE_DOMAIN=

AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
SCIENTIST_ENABLED=false
# Optional exact-model token pricing. Costs remain unavailable unless both pricing and a
# traceable pricing source are supplied. These are estimates, not provider invoices.
AI_MODEL_PRICING_JSON={}
AI_PRICING_SOURCE=
# Example: AI_MODEL_PRICING_JSON='{"model-name":{"input_usd_per_million_tokens":"2.5","output_usd_per_million_tokens":"10"}}'

# Browser-visible values (Next.js reads NEXT_PUBLIC_*, Vite reads VITE_*). Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_SOCIAL_APP_URL=http://localhost:3000
