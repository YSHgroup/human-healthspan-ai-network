JWT_SECRET=development-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_APP_URL=http://localhost:3000

# AI providers. 'extractive' is offline and cites sources only. Set AI_PROVIDER=anthropic with
# AI_API_KEY and AI_MODEL to let the General Platform AI use an external model.
AI_PROVIDER=extractive
AI_API_KEY=
AI_MODEL=
AI_ALLOW_EXTERNAL_FOR_PRIVATE=false

# Portal URLs (used for cross-portal navigation) and shared-session cookie domain for production
SOCIAL_APP_URL=http://localhost:3000
PERSONAL_APP_URL=http://localhost:3001
RESEARCHER_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3004
